---
import "../styles/global.css";
import HeroIntro from "../components/HeroIntro.astro";
import InfoPanel from "../components/InfoPanel.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

const instagramUrl = "https://www.instagram.com/life_home_/";
const mapsUrl = "https://maps.app.goo.gl/aFwUA3xvGxwPZXBT7";
const churchUrl = "https://icepuertollano.es/";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Life Home: un lugar para encontrarnos, crecer y vivir la fe juntos. Nos vemos cada viernes a las 19:45."
    />
    <meta name="theme-color" content="oklch(95.45% 0.0108 95.17)" />
    <meta property="og:title" content="Life Home" />
    <meta
      property="og:description"
      content="Un lugar para encontrarnos, crecer y vivir la fe juntos. Viernes a las 19:45."
    />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (() => {
        const storageKey = "theme";
        const root = document.documentElement;
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

        const storedTheme = (() => {
          try {
            return localStorage.getItem(storageKey);
          } catch {
            return null;
          }
        })();

        const applyTheme = (theme) => {
          const isDark = theme === "dark";
          root.classList.toggle("dark", isDark);
          root.style.colorScheme = theme;

          const toggle = document.querySelector("#theme-toggle");
          if (toggle) {
            toggle.setAttribute("aria-pressed", String(isDark));
            toggle.setAttribute(
              "aria-label",
              isDark ? "Activar modo claro" : "Activar modo oscuro",
            );
          }

          const themeColor = document.querySelector('meta[name="theme-color"]');
          const colorToken = isDark ? "--color-zinc-950" : "--color-paper";
          const color = getComputedStyle(root)
            .getPropertyValue(colorToken)
            .trim();
          if (themeColor && color) themeColor.setAttribute("content", color);
        };

        const initialTheme =
          storedTheme === "dark" || storedTheme === "light"
            ? storedTheme
            : systemTheme.matches
              ? "dark"
              : "light";

        applyTheme(initialTheme);

        document.addEventListener("DOMContentLoaded", () => {
          applyTheme(root.classList.contains("dark") ? "dark" : "light");

          document
            .querySelector("#theme-toggle")
            ?.addEventListener("click", () => {
              const theme = root.classList.contains("dark") ? "light" : "dark";
              try {
                localStorage.setItem(storageKey, theme);
              } catch {
                // Keep theme switching functional when storage is unavailable.
              }

              const reducedMotion = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
              ).matches;
              if (!("startViewTransition" in document) || reducedMotion) {
                applyTheme(theme);
                return;
              }

              root.dataset.themeTransition = theme;
              const transition = document.startViewTransition(() =>
                applyTheme(theme),
              );
              transition.finished.finally(() => {
                delete root.dataset.themeTransition;
              });
            });
        });

        systemTheme.addEventListener("change", (event) => {
          try {
            if (localStorage.getItem(storageKey)) return;
          } catch {
            // Fall back to the system preference when storage is unavailable.
          }
          applyTheme(event.matches ? "dark" : "light");
        });
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>Life Home | Jóvenes, fe y comunidad</title>
  </head>
  <body class="m-0 min-w-80 bg-paper font-sans text-ink antialiased [font-synthesis:none] dark:bg-zinc-950 dark:text-zinc-100">
    <div class="grid min-h-dvh grid-rows-[auto_1fr_auto] overflow-x-clip bg-paper bg-paper-texture dark:bg-zinc-950 dark:bg-night-glow">
      <SiteHeader churchUrl={churchUrl} />

      <main class="grid w-full place-items-start justify-items-center px-[clamp(1.25rem,5vw,5rem)] py-[clamp(3rem,7vh,5.5rem)] max-[480px]:py-12">
        <section
          class="grid w-full max-w-320 animate-arrive grid-cols-[minmax(0,1.15fr)_minmax(19rem,0.85fr)] items-start gap-[clamp(4rem,10vw,10rem)] motion-reduce:animate-none max-[800px]:grid-cols-1 max-[800px]:gap-14"
          aria-labelledby="page-title"
        >
          <HeroIntro />
          <InfoPanel instagramUrl={instagramUrl} mapsUrl={mapsUrl} />
        </section>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
