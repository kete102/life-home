---
interface Props {
  instagramUrl: string;
  mapsUrl: string;
}

const { instagramUrl, mapsUrl } = Astro.props;
---

<div class="max-[800px]:w-full">
  <nav aria-label="Redes sociales">
    <a class="group relative flex w-full cursor-pointer items-center justify-between gap-4 overflow-hidden bg-instagram bg-ink px-6 py-[1.35rem] text-light no-underline transition-[transform,opacity] duration-150 before:absolute before:inset-0 before:bg-instagram-hover before:transition-transform before:duration-500 before:ease-fluid before:content-[''] before:-translate-x-full hover:before:translate-x-0 active:scale-[0.985] active:opacity-90 active:before:translate-x-0 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-acid focus-visible:before:translate-x-0 motion-reduce:transition-none motion-reduce:before:transition-none" href={instagramUrl} target="_blank" rel="noreferrer">
      <span class="relative z-10 grid size-11 shrink-0 place-items-center border border-light/20" aria-hidden="true">
        <svg class="size-[1.35rem] stroke-current stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round]" viewBox="0 0 24 24" fill="none">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle class="fill-current stroke-none" cx="17.5" cy="6.5" r="1" />
        </svg>
      </span>
      <span class="relative z-10 mr-auto">
        <small class="mb-0.5 block text-[0.65rem] font-medium tracking-[0.12em] text-light/58 uppercase">Síguenos en</small>
        <strong class="text-[1.1rem] font-medium">Instagram</strong>
      </span>
      <svg class="relative z-10 w-7 stroke-current stroke-[1.5] transition-transform duration-180 [stroke-linecap:round] [stroke-linejoin:round] group-hover:translate-x-1 group-focus-visible:translate-x-1 motion-reduce:transition-none" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14M14 7l5 5-5 5" />
      </svg>
    </a>
  </nav>

  <div class="flex items-end justify-between gap-4 border-t border-ink/20 px-0 pt-10 pb-12 max-[480px]:pt-7 max-[480px]:pb-9" aria-label="Nos reunimos todos los viernes a las 19:45">
    <div>
      <span class="mb-1.5 block text-[0.68rem] font-medium tracking-[0.12em] text-ink-soft uppercase">Cada semana</span>
      <strong class="text-[clamp(2rem,4vw,3.5rem)] font-medium tracking-[-0.06em]">Viernes</strong>
    </div>
    <time class="text-[clamp(2rem,4vw,3.5rem)] font-light tracking-[-0.07em]" datetime="19:45">19:45</time>
  </div>

  <a class="group flex origin-center items-center justify-between gap-6 border-t border-ink/20 py-[1.4rem] text-ink no-underline transition-[transform,opacity] duration-150 active:scale-[0.985] active:opacity-65 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-acid motion-reduce:transition-none" href={mapsUrl} target="_blank" rel="noreferrer">
    <span>
      <small class="mb-[0.45rem] block text-[0.65rem] font-semibold tracking-[0.12em] text-ink-soft uppercase">Dónde encontrarnos</small>
      <strong class="mb-0.5 block text-[1.1rem] font-medium">C. Ancha, 23</strong>
      <span class="block text-[0.85rem] text-ink-soft">13500 Puertollano, Ciudad Real</span>
    </span>
    <svg class="w-7 shrink-0 stroke-current stroke-[1.5] transition-transform duration-180 [stroke-linecap:round] [stroke-linejoin:round] group-hover:-translate-y-0.75 motion-reduce:transition-none" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 21s7-6.1 7-12A7 7 0 0 0 5 9c0 5.9 7 12 7 12Z" />
      <circle cx="12" cy="9" r="2.5" />
    </svg>
  </a>
</div>
